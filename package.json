  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc --watch",
    "test": "mocha --recursive --timeout 10000 --exit \"test/lib/**/*.js\"",
    "test:all": "mocha --recursive --timeout 10000 --exit \"test/**/*.js\"",
    "test:unit": "mocha --recursive --timeout 10000 --exit \"test/lib/**/*.js\"",
    "test:storage": "mocha --timeout 10000 --exit ./test/storage/*.js",
    "test:translation": "mocha ./test/translation/*.js",
    "test:coverage": "c8 mocha --recursive --timeout 10000 --exit \"test/lib/**/*.js\"",
    "test:coverage:report": "c8 report --reporter=html"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@rocketsoftware/eureka-js-client": "4.5.9",
    "@rocketsoftware/express-ws": "5.0.1",
    "bluebird": "3.7.2",
    "body-parser": "1.20.3",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "express-session": "1.18.2",
    "express-static-gzip": "2.1.7",
    "graceful-fs": "4.2.11",
    "ipaddr.js": "2.1.0",
    "node-forge": "1.4.0",
    "semver": "7.6.2",
    "ws": "6.2.3",
    "yaml": "2.4.5",
    "yauzl": "3.1.3"
  },
  "devDependencies": {
    "@types/connect": "3.4.35",
    "@types/express": "4.17.17",
    "@types/express-serve-static-core": "4.17.35",
    "@types/mime": "3.0.1",
