    "@types/qs": "6.9.3",
    "chai": "4.2.0",
    "chai-http": "4.2.1",
    "c8": "10.1.3",
    "mocha": "11.2.2",
    "sinon": "21.0.3",
    "typescript": "5.0.4"
  },
  "optionalDependencies": {
    "fsevents": "2.3.3",
    "keyring_js": "1.1.0"
